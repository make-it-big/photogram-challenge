<div class="card">
  <header>
    <h1>
      List of all comments
    </h1>
  </header>

  <ul>
    <% @list_of_comments.each do |a_comment| %>
      <li>
        <a href="/comments/<%= a_comment.id %>">
          Comment #<%= a_comment.id %>
        </a>
      </li>
    <% end %>
  </ul>
</div>

<div class="card">
  <header>
    <h2>
      Add a new comment
    </h2>
  </header>

  <form action="/insert_comment" method="post">
    <div>
      <label for="author_id_field">
        Author
      </label>

      <input type="number" id="author_id_field" name="author_id_param">
    </div>

    <div>
      <label for="body_field">
        Body
      </label>

      <textarea id="body_field" name="body_param" rows="3"></textarea>
    </div>

    <div>
      <label for="photo_id_field">
        Photo
      </label>

      <input type="number" id="photo_id_field" name="photo_id_param">
    </div>

    <button type="submit">
      Create comment
    </button>
  </form>
</div>
