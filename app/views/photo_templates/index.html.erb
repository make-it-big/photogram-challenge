<div class="card">
  <header>
    <h2>
      Add a photo
    </h2>
  </header>

  
    <% if current_user.present? %>
      
      <form action="/insert_photo" method="post" enctype="multipart/form-data">
        <label for="image_field">
          Image
        </label>

        <input type="file" id="image_field" name="image_param" accept="image/*" required="">

        <label for="caption_field">
          Caption
        </label>

        <textarea id="caption_field" name="caption_param" rows="2" placeholder="Say something about your photo..."></textarea>

        <button type="submit">
          Add photo
        </button>
      </form>

    <% else %>
        <p><a href="/users/sign_in">Sign in</a>  to add a photo.</p>
    <% end %>
</div>


<div class="card">
  <header>
    <h1>
      Public photos
    </h1>
  </header>

  <ul>
    <% @list_of_photos.each do |a_photo| %>
      <li>
        <a href="/photos/<%= a_photo.id %>">
          <img src="<%= a_photo.image_url %>" alt="" class="w-20 h-20 object-cover rounded">

          <span>
            <%= a_photo.caption %>

            <small class="block">
              <%= a_photo.owner.username %> · <%= time_ago_in_words(a_photo.created_at) %> ago

            </small>
          </span>
        </a>
      </li>
    <% end %>
  </ul>
</div>
