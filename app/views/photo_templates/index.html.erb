<div class="card">
  <header>
    <h1>
      List of all photos
    </h1>
  </header>

  <ul>
    <% @list_of_photos.each do |a_photo| %>
      <li>
        <a href="/photos/<%= a_photo.id %>">
          Photo #<%= a_photo.id %>
        </a>
      </li>
    <% end %>
  </ul>
</div>

<div class="card">
  <header>
    <h2>
      Add a new photo
    </h2>
  </header>

  <form action="/insert_photo" method="post">
    <div>
      <label for="caption_field">
        Caption
      </label>

      <textarea id="caption_field" name="caption_param" rows="3"></textarea>
    </div>

    <div>
      <label for="ccomments_count_field">
        Ccomments count
      </label>

      <input type="number" id="ccomments_count_field" name="ccomments_count_param">
    </div>

    <div>
      <label for="image_field">
        Image
      </label>

      <input type="text" id="image_field" name="image_param">
    </div>

    <div>
      <label for="likes_count_field">
        Likes count
      </label>

      <input type="number" id="likes_count_field" name="likes_count_param">
    </div>

    <div>
      <label for="owner_id_field">
        Owner
      </label>

      <input type="number" id="owner_id_field" name="owner_id_param">
    </div>

    <button type="submit">
      Create photo
    </button>
  </form>
</div>
