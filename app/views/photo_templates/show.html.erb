<nav aria-label="breadcrumb">
  <ul>
    <li><a href="/photos">Photos</a></li>
    <li><a href="/users/<%= @the_photo.owner.username %>"><%= @the_photo.owner.username %></a></li>
    <li>Photo </li>
  </ul>
</nav>

<div class="card">
  <header class="flex justify-between items-center">
    <a href="/users/<%= @the_photo.owner.username %>">
      <strong><%= @the_photo.owner.username %></strong>
    </a>

    <small>
      Posted <%= time_ago_in_words(@the_photo.created_at) %> ago
    </small>
  </header>

  <img src="<%= @the_photo.image %>" alt="<%= @the_photo.caption %>" class="block max-w-full mx-auto rounded mb-4">

  <p><%= @the_photo.caption %></p>

  <p><strong><%= @list_of_likes.count %> likes</strong>
  <small>from
    <% @list_of_likes.each do |like| %>
      <%= like.fan.username %>, 
    <% end %>
  </small>
  </p>

  <% if @current_user_like_status %>
    <a href="/delete_like/<%= @the_photo.id %>" class="btn btn-outline">
      Unlike
    </a>
  <% else %>
    <form action="/insert_like" method="post">
      <input type="hidden" name="photo_id_param" value="<%= @the_photo.id %>">

      <button type="submit" class="btn btn-outline-primary w-auto">
        Like
      </button>
    </form>
  <% end %>
  
</div>


<% if @the_photo.owner.id == current_user.id %>
<div class="card">
  <header class="flex justify-between items-center">
    <h2>Edit photo</h2>

    <a href="/delete_photo/<%= @the_photo.id %>" class="btn btn-outline-danger btn-sm">
      Delete this photo
    </a>
  </header>

  <form action="/modify_photo/<%= @the_photo.id %>" method="post" enctype="multipart/form-data">
      <label for="image_field">
        Replace image
      </label>

      <input type="file" id="image_field" name="image_param" accept="image/*">

      <label for="caption_field">
        Caption
      </label>

      <textarea id="caption_field" name="caption_param" rows="2"><%= @the_photo.caption %></textarea>

      <button type="submit">
        Update photo
      </button>
    </form>
</div>
<% end %>


<div class="card">
  <header>
    <h2><%= @the_photo.comments.count %> comments</h2>
  </header>

  <ul>
    <% @the_photo.comments.each do |comment| %>
      <li>
        <strong><%= comment.fan.username %></strong>

        <%= comment.body %>

        <small class="block">
          <%= time_ago_in_words(comment.created_at) %> ago
        </small>
      </li>
    <% end %>
  </ul>

  <form action="/insert_comment" method="post" class="mt-4">
    <input type="hidden" name="photo_id_param" value="<%= @the_photo.id %>">

    <label for="body_field">
      Comment
    </label>

    <textarea id="body_field" name="body_param" rows="2" placeholder="Add a comment..."></textarea>

    <button type="submit">
      Add comment
    </button>
  </form>
</div>
